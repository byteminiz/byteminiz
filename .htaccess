# =========================
# ROOT .htaccess — Performance (clean)
# Apache + Laravel/public
# =========================

# --- Charset & Options ---
AddDefaultCharset UTF-8
Options -Indexes -MultiViews

# --- Security headers (cheap, safe) ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Correct MIME types ---
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType application/font-sfnt .ttf
  AddType application/vnd.ms-fontobject .eot
</IfModule>

# --- Compression: Brotli first, then Gzip ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css \
    application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css \
    application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  Header always append Vary "Accept-Encoding"
</IfModule>

# --- Caching: long for static, fresh for HTML ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Static assets (use filename hashing/fingerprints)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType application/font-sfnt "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # HTML should update immediately on deploy
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Strong caching for assets; allow fonts cross-origin
  <FilesMatch "\.(?:js|css|png|jpe?g|gif|webp|svg|avif|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # No cache for HTML/PHP documents
  <FilesMatch "\.(?:html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# --- ETags off (leaner caching) ---
FileETag None

# --- Rewrites: serve files fast, send real 404 for missing assets, then Laravel ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) If a file/dir exists at root, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2) If a file exists under /public, serve it (bypass PHP)
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^ public%{REQUEST_URI} [L]

  # 3) Real 404 for missing asset-like URLs (avoid HTML served as JS/CSS)
  RewriteCond %{REQUEST_URI} \.(?:js|css|map|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot)$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-f
  RewriteRule ^ - [R=404,L]

  # 4) Everything else → Laravel front controller
  RewriteRule ^ public/index.php [L]
</IfModule>

# --- Preload + preconnect for Merienda (self-hosted) — scope to HTML/PHP only ---
# Put your font at: /public/fonts/Merienda-Variable.woff2
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|php)$">
    Header setifempty Link "</fonts/Merienda-Variable.woff2>; rel=preload; as=font; type=font/woff2; crossorigin, \
<https://fonts.googleapis.com>; rel=preconnect, \
<https://fonts.gstatic.com>; rel=preconnect; crossorigin"
  </FilesMatch>
</IfModule>
